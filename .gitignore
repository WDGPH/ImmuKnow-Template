# Python
__pycache__/
*.py[cod]
.venv/

# uv.lock pins maintainer tools. core-revision.txt pins the native application.

# Run output contains client information and is never committed. Both names
# match at any depth: runs/ is the default, output/ holds runs from older
# versions of this template.
runs/
output/

# Client data in any folder, for runs saved outside runs/ or input/.
*.csv
*.xls
*.xlsx
*.xlsm
*.pdf
*.parquet
*.zip
*.log
run.json
report.html

# Input data may contain client information. Only the fictional sample and its assignments are tracked.
# Keep cohort CSVs and assignments files in input/: an assignments file lists
# client IDs and, being .json, is only ignored inside this folder.
input/*
!input/sample/
input/sample/*
!input/sample/sample_students.csv
!input/sample/sample_assignments.json

# Staging left by interrupted library setup. Check for retained previous files
# before deleting after a reported recovery failure.
.sync-lib-*/

# Tools
.pytest_cache/
.DS_Store
Thumbs.db
.vscode/
.idea/

# Exported from the reviewed native executable, never edited or committed.
/templates/lib/immuknow/
# Resource package build output.
**/build/
**/*.egg-info/
/dist/

# Temporary resource export used for manual library setup.
/core-resources/

# Native build cache used by project CI.
/target/
